--- mnt/init
+++ mnt/init
@@ -107,6 +107,14 @@
 export SHELL=/bin/bash
 export HOME=/root

+_bench=$(grep -oP "\bBENCH_RUNS=\K[0-9]+" /proc/cmdline || true)
+if [[ -n "$_bench" ]]; then
+    for _i in $(seq 1 "$_bench"); do
+        /root/git-projects/dhrystone/dhrystone
+    done
+    echo o > /proc/sysrq-trigger
+    exit 0
+fi
 /bin/bash

 set +x
